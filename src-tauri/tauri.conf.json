{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RenForge",
  "version": "1.3.2",
  "identifier": "com.foulnike.renforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows":[
      {
        "title": "RenForge",
        "width": 1200,
        "height": 800,
        "minWidth": 940,
        "minHeight": 620
      }
    ],
    "security": {
        "assetProtocol": {
          "enable": true,
          "scope": ["**"]
        }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon":[
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" }
    },
    "externalBin":[
      "bin/unrpa",
      "bin/rpyc_extractor"
    ],
    "resources": [
      "licenses/*"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5QjFBQTMzQjcwOUQ0QkEKUldTNjFBbTNNNnF4R1U4Um1Zd0lDVXA4VjlLZlJtWi9lczBvRVBwTXFsMWJmZ2VSSDdpZDNFcWsK",
      "endpoints": [
        "https://github.com/foulnike/RenForge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
